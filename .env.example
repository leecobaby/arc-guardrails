# Public Arc endpoints. Override only if you use a trusted RPC provider.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Never commit real private keys. Use a dedicated, minimally funded deployer.
DEPLOYER_PRIVATE_KEY=0x

# Defaults to the deployer when omitted.
INITIAL_OWNER_ADDRESS=

# Arc's canonical six-decimal ERC-20 interface for USDC.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Browser-visible deployment addresses. Fill these after deployment.
NEXT_PUBLIC_TESTNET_VAULT_ADDRESS=
NEXT_PUBLIC_MAINNET_VAULT_ADDRESS=
